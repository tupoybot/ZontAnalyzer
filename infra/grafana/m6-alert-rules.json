    {
      "uid": "zont-m6-${environment}-model-overdue",
      "title": "M6: Просрочен пересмотр модели",
      "folderUID": "zont-m6",
      "ruleGroup": "m6-${environment}",
      "orgId": 1,
      "condition": "B",
      "noDataState": "OK",
      "execErrState": "Alerting",
      "for": "5m",
      "isPaused": true,
      "labels": {
        "project": "zont-m6",
        "environment": "${environment}"
