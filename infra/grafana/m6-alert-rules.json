{
  "rules": [
    {
      "uid": "zont-m6-${environment}-sync",
      "title": "M6: Ошибка синхронизации",
      "folderUID": "zont-m6",
      "ruleGroup": "m6-${environment}",
      "orgId": 1,
      "condition": "B",
      "noDataState": "Alerting",
      "execErrState": "Alerting",
      "for": "5m",
      "isPaused": true,
      "labels": {
        "project": "zont-m6",
        "environment": "${environment}"
      },
      "annotations": {
        "summary": "Синхронизация завершилась ошибкой либо измерения отсутствуют 48 часов."
      },
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 172800,
            "to": 0
          },
          "datasourceUid": "${datasource_uid}",
          "model": {
            "expr": "(1 - min(last_over_time(zont_sync_success{environment=\"${environment}\"}[48h]) and (last_over_time(zont_sync_observed_timestamp_seconds{environment=\"${environment}\"}[48h]) == on (environment) group_left max by (environment) (last_over_time(zont_sync_observed_timestamp_seconds{environment=\"${environment}\"}[48h]))))) or vector(1)",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 60000,
            "maxDataPoints": 1440
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "type": "query",
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0
                  ]
                },
                "operator": {
                  "type": "and"
                },
                "reducer": {
                  "type": "last",
                  "params": []
                },
                "query": {
                  "params": [
                    "B"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "uid": "zont-m6-${environment}-stale",
      "title": "M6: Устаревшая телеметрия",
      "folderUID": "zont-m6",
      "ruleGroup": "m6-${environment}",
      "orgId": 1,
      "condition": "B",
      "noDataState": "Alerting",
      "execErrState": "Alerting",
      "for": "5m",
      "isPaused": true,
      "labels": {
        "project": "zont-m6",
        "environment": "${environment}"
      },
      "annotations": {
        "summary": "Возраст телеметрии превышает настроенный порог (по умолчанию 30 часов) либо метрика отсутствует."
      },
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 172800,
            "to": 0
          },
          "datasourceUid": "${datasource_uid}",
          "model": {
            "expr": "((time() - max(last_over_time(zont_telemetry_timestamp_seconds{environment=\"${environment}\"}[48h]))) and (min(last_over_time(zont_telemetry_present{environment=\"${environment}\"}[2h]) and (last_over_time(zont_snapshot_observed_timestamp_seconds{environment=\"${environment}\"}[2h]) == on (environment) group_left max by (environment) (last_over_time(zont_snapshot_observed_timestamp_seconds{environment=\"${environment}\"}[2h])))) == 1)) or vector(172800)",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 60000,
            "maxDataPoints": 1440
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "type": "query",
                "evaluator": {
                  "type": "gt",
                  "params": [
                    108000
                  ]
                },
                "operator": {
                  "type": "and"
                },
                "reducer": {
                  "type": "last",
                  "params": []
                },
                "query": {
                  "params": [
                    "B"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "uid": "zont-m6-${environment}-job",
      "title": "M6: Ошибка выполнения задания",
      "folderUID": "zont-m6",
      "ruleGroup": "m6-${environment}",
      "orgId": 1,
      "condition": "B",
      "noDataState": "Alerting",
      "execErrState": "Alerting",
      "for": "5m",
      "isPaused": true,
      "labels": {
        "project": "zont-m6",
        "environment": "${environment}"
      },
      "annotations": {
        "summary": "Ошибка задания или отсутствие измерений в течение двух часов; проверить также ошибки и таймауты платформы."
      },
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 172800,
            "to": 0
          },
          "datasourceUid": "${datasource_uid}",
          "model": {
            "expr": "(1 - min(last_over_time(zont_cloud_job_success{environment=\"${environment}\"}[2h]) and (last_over_time(zont_cloud_job_observed_timestamp_seconds{environment=\"${environment}\"}[2h]) == on (environment, operation) group_left max by (environment, operation) (last_over_time(zont_cloud_job_observed_timestamp_seconds{environment=\"${environment}\"}[2h]))))) or vector(1)",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 60000,
            "maxDataPoints": 1440
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "type": "query",
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0
                  ]
                },
                "operator": {
                  "type": "and"
                },
                "reducer": {
                  "type": "last",
                  "params": []
                },
                "query": {
                  "params": [
                    "B"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "uid": "zont-m6-${environment}-loops",
      "title": "M6: Частые вызовы контейнера",
      "folderUID": "zont-m6",
      "ruleGroup": "m6-${environment}",
      "orgId": 1,
      "condition": "B",
      "noDataState": "OK",
      "execErrState": "Alerting",
      "for": "5m",
      "isPaused": true,
      "labels": {
        "project": "zont-m6",
        "environment": "${environment}"
      },
      "annotations": {
        "summary": "Частота вызовов выше настроенного порога (по умолчанию 180 в час). Проверить повторы и расписание."
      },
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 172800,
            "to": 0
          },
          "datasourceUid": "${datasource_uid}",
          "model": {
            "expr": "sum(increase(zont_invocations_total{environment=\"${environment}\"}[1h]))",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 60000,
            "maxDataPoints": 1440
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "type": "query",
                "evaluator": {
                  "type": "gt",
                  "params": [
                    180
                  ]
                },
                "operator": {
                  "type": "and"
                },
                "reducer": {
                  "type": "last",
                  "params": []
                },
                "query": {
                  "params": [
                    "B"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
