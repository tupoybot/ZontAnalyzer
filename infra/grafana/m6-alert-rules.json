    {
      "uid": "zont-m6-${environment}-proxy",
      "title": "M6: Недоступность прокси",
      "folderUID": "zont-m6",
      "ruleGroup": "m6-${environment}",
      "orgId": 1,
      "condition": "B",
      "noDataState": "Alerting",
      "execErrState": "Alerting",
      "for": "0s",
      "isPaused": true,
      "labels": {
        "project": "zont-m6",
        "environment": "${environment}"
      },
      "annotations": {
        "summary": "Прокси не готов по последней проверке мониторинга или за час зарегистрированы ошибки прокси. Ошибки внешнего API учитываются отдельно."
      },
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 172800,
            "to": 0
          },
          "datasourceUid": "${datasource_uid}",
          "model": {
            "expr": "(1 - min(last_over_time(zont_proxy_ready{environment=\"${environment}\"}[2h]) and ignoring (operation) (last_over_time(zont_cloud_job_observed_timestamp_seconds{environment=\"${environment}\",operation=\"monitoring\"}[2h]) == on (environment) group_left max by (environment) (last_over_time(zont_cloud_job_observed_timestamp_seconds{environment=\"${environment}\",operation=\"monitoring\"}[2h]))))) + (sum(increase(zont_proxy_failures_total{environment=\"${environment}\"}[1h])) or vector(0))",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 60000,
            "maxDataPoints": 1440
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "type": "query",
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0
                  ]
                },
                "operator": {
                  "type": "and"
                },
                "reducer": {
                  "type": "last",
                  "params": []
                },
                "query": {
                  "params": [
                    "B"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "uid": "zont-m6-${environment}-budget",
      "title": "M6: месячный бюджет токенов",
      "folderUID": "zont-m6",
      "ruleGroup": "m6-${environment}",
      "orgId": 1,
      "condition": "B",
      "noDataState": "OK",
      "execErrState": "Alerting",
      "for": "5m",
      "isPaused": true,
      "labels": {
        "project": "zont-m6",
        "environment": "${environment}"
      },
      "annotations": {
        "summary": "Расход и резерв токенов достигли настроенной доли месячного бюджета (по умолчанию 80%). Это не денежный бюджет облака."
      },
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 172800,
            "to": 0
          },
          "datasourceUid": "${datasource_uid}",
          "model": {
            "expr": "(max(last_over_time(zont_monthly_ai_tokens{environment=\"${environment}\"}[2h])) + max(last_over_time(zont_monthly_ai_reserved_tokens{environment=\"${environment}\"}[2h]))) / (max(last_over_time(zont_monthly_ai_token_budget{environment=\"${environment}\"}[2h])) > 0)",
            "instant": true,
            "range": false,
            "refId": "A",
            "intervalMs": 60000,
            "maxDataPoints": 1440
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "type": "query",
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0.8
                  ]
                },
                "operator": {
                  "type": "and"
                },
                "reducer": {
                  "type": "last",
                  "params": []
                },
                "query": {
                  "params": [
                    "B"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
