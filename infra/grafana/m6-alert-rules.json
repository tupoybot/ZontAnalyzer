          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "type": "query",
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0
                  ]
                },
                "operator": {
                  "type": "and"
                },
                "reducer": {
                  "type": "last",
                  "params": []
                },
                "query": {
