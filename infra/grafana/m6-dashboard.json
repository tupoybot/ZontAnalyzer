{
  "uid": "zont-m6-overview",
  "title": "ZontAnalyzer — M6",
  "tags": [
    "zont-m6"
  ],
  "schemaVersion": 39,
  "version": 0,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Метрики",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "environment",
        "label": "Окружение",
        "type": "custom",
        "query": "dev,pilot",
        "current": {
          "text": "dev",
          "value": "dev"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 31,
      "title": "Ожидают публикации",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "description": "Последний успешный снимок, не старше 15 минут. Ошибка последнего чтения скрывает прежние значения. При ограниченном чтении число является нижней границей; см. точность снимка. Число отчётов в сформированной очереди; ещё не обработанные изменения журнала не включены.",
      "targets": [
        {
          "refId": "A",
          "expr": "max(last_over_time(zont_queue_items{environment=\"$environment\",kind=\"publication\",status=\"pending\"}[2h]) and ignoring (status) (((last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]) == on (environment,kind) group_left max by (environment,kind) (last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]))) and (last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]) > time() - 900)) and (last_over_time(zont_queue_snapshot_success{environment=\"$environment\"}[2h]) == 1)))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "Ожидают публикации",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "Нет свежих данных"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 32,
      "title": "Ручные задания: ожидают",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "description": "Последний успешный снимок, не старше 15 минут. Ошибка последнего чтения скрывает прежние значения. При ограниченном чтении число является нижней границей; см. точность снимка.",
      "targets": [
        {
          "refId": "A",
          "expr": "max(last_over_time(zont_queue_items{environment=\"$environment\",kind=\"manual\",status=\"pending\"}[2h]) and ignoring (status) (((last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]) == on (environment,kind) group_left max by (environment,kind) (last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]))) and (last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]) > time() - 900)) and (last_over_time(zont_queue_snapshot_success{environment=\"$environment\"}[2h]) == 1)))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "Ручные задания: ожидают",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "Нет свежих данных"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 33,
      "title": "Ручные задания: выполняются",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
