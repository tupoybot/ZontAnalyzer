        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 36,
      "title": "Возраст старейшего состояния в очереди",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "description": "Публикация: время ожидания отчёта. Ручные задания: возраст последнего изменения состояния самого старого задания, включая выполнение и требующее разбора. Показывается только при полном чтении и известном времени; это не обязательно время первого нажатия.",
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (kind) ((last_over_time(zont_queue_oldest_timestamp_seconds{environment=\"$environment\"}[2h]) and ignoring (status) (((last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]) == on (environment,kind) group_left max by (environment,kind) (last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]))) and (last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]) > time() - 900)) and (last_over_time(zont_queue_snapshot_success{environment=\"$environment\"}[2h]) == 1)) ) > 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{kind}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "Нет свежих данных"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "publication"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Публикация"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "manual"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Ручные задания"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 37,
      "title": "Возраст последнего снимка очередей",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 5
      },
      "description": "Время после последней попытки измерения. Размер очереди скрывается при ошибке чтения или возрасте снимка более 15 минут.",
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (kind) (last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{kind}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "Нет свежих данных"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "publication"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Публикация"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "manual"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Ручные задания"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 38,
      "title": "Состояние чтения очередей",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 5
      },
      "description": "1 — успешно, 0 — ошибка; отсутствие данных не означает пустую очередь.",
      "targets": [
        {
          "refId": "A",
          "expr": "min by (kind) (last_over_time(zont_queue_snapshot_success{environment=\"$environment\"}[2h]) and ((last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]) == on (environment,kind) group_left max by (environment,kind) (last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]))) and (last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]) > time() - 900)))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{kind}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "Нет свежих данных",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Ошибка",
                  "color": "red"
                },
                "1": {
                  "text": "Успешно",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "publication"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Публикация"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "manual"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Ручные задания"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 39,
      "title": "Точность снимка очередей",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 5
      },
      "description": "Полное чтение даёт точное число. Ограниченное чтение даёт нижнюю границу и скрывает возраст старейшего задания.",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (kind) (last_over_time(zont_queue_truncated{environment=\"$environment\"}[2h]) and ignoring (status) (((last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]) == on (environment,kind) group_left max by (environment,kind) (last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]))) and (last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]) > time() - 900)) and (last_over_time(zont_queue_snapshot_success{environment=\"$environment\"}[2h]) == 1)))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{kind}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "Нет свежих данных",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Точно",
                  "color": "green"
                },
                "1": {
                  "text": "Нижняя граница",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "publication"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Публикация"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "manual"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Ручные задания"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 1,
      "title": "Результат синхронизации (1 — успех)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(last_over_time(zont_sync_success{environment=\"$environment\"}[48h]) and (last_over_time(zont_sync_observed_timestamp_seconds{environment=\"$environment\"}[48h]) == on (environment) group_left max by (environment) (last_over_time(zont_sync_observed_timestamp_seconds{environment=\"$environment\"}[48h]))))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{operation}} {{outcome}} {{kind}} {{destination}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Возраст последней телеметрии",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
