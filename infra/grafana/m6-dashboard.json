      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 35,
      "title": "Очереди: изменение размера",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "description": "Последний успешный снимок, не старше 15 минут. Ошибка последнего чтения скрывает прежние значения. При ограниченном чтении число является нижней границей; см. точность снимка.",
      "targets": [
        {
          "refId": "A",
          "expr": "max(last_over_time(zont_queue_items{environment=\"$environment\",kind=\"publication\",status=\"pending\"}[2h]) and ignoring (status) (((last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]) == on (environment,kind) group_left max by (environment,kind) (last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]))) and (last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]) > time() - 900)) and (last_over_time(zont_queue_snapshot_success{environment=\"$environment\"}[2h]) == 1)))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "Публикация",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "max(last_over_time(zont_queue_items{environment=\"$environment\",kind=\"manual\",status=\"pending\"}[2h]) and ignoring (status) (((last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]) == on (environment,kind) group_left max by (environment,kind) (last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]))) and (last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]) > time() - 900)) and (last_over_time(zont_queue_snapshot_success{environment=\"$environment\"}[2h]) == 1)))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "Ручные: ожидают",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "expr": "max(last_over_time(zont_queue_items{environment=\"$environment\",kind=\"manual\",status=\"running\"}[2h]) and ignoring (status) (((last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]) == on (environment,kind) group_left max by (environment,kind) (last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]))) and (last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]) > time() - 900)) and (last_over_time(zont_queue_snapshot_success{environment=\"$environment\"}[2h]) == 1)))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "Ручные: выполняются",
          "instant": false,
          "range": true
        },
        {
          "refId": "D",
          "expr": "max(last_over_time(zont_queue_items{environment=\"$environment\",kind=\"manual\",status=\"blocked\"}[2h]) and ignoring (status) (((last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]) == on (environment,kind) group_left max by (environment,kind) (last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]))) and (last_over_time(zont_queue_observed_timestamp_seconds{environment=\"$environment\"}[2h]) > time() - 900)) and (last_over_time(zont_queue_snapshot_success{environment=\"$environment\"}[2h]) == 1)))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "Ручные: требуют разбора",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
