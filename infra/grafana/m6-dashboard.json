      "targets": [
        {
          "refId": "A",
          "expr": "min by (operation) (last_over_time(zont_cloud_job_success{environment=\"$environment\"}[2h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{operation}} {{outcome}} {{kind}} {{destination}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "title": "Срок следующего пересмотра модели",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(min(last_over_time(zont_model_review_next_due_timestamp_seconds{environment=\"$environment\"}[2h]) and (last_over_time(zont_snapshot_observed_timestamp_seconds{environment=\"$environment\"}[2h]) == on (environment) group_left max by (environment) (last_over_time(zont_snapshot_observed_timestamp_seconds{environment=\"$environment\"}[2h])))) and (min(last_over_time(zont_model_review_enabled{environment=\"$environment\"}[2h]) and (last_over_time(zont_snapshot_observed_timestamp_seconds{environment=\"$environment\"}[2h]) == on (environment) group_left max by (environment) (last_over_time(zont_snapshot_observed_timestamp_seconds{environment=\"$environment\"}[2h])))) == 1)) * 1000",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "options": {}
    },
