    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Доля запросов с известными серверными RU и полнота статистики CPU/чтения-записи. Флаги полноты: 1 — полные данные, 0 — неполные; отсутствие ряда — неизвестно.",
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "noValue": "Нет данных (неизвестно)"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "zont_lab_ru_coverage_ratio", "legendFormat": "RU {{variant}} / {{suite}} / {{years}} лет / {{scenario}} / {{window}} с", "refId": "A"},
        {"expr": "zont_lab_stats_coverage_ratio", "legendFormat": "Статистика {{variant}} / {{suite}} / {{years}} лет / {{scenario}}", "refId": "B"},
        {"expr": "zont_lab_stats_complete", "legendFormat": "Все статистики {{variant}} / {{suite}} / {{years}} лет / {{scenario}}", "refId": "C"},
        {"expr": "zont_lab_cpu_complete", "legendFormat": "CPU {{variant}} / {{suite}} / {{years}} лет / {{scenario}}", "refId": "D"},
