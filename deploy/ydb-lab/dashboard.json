      ],
      "title": "Покрытие RU и статистики",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Снимок по завершённым запросам последнего повтора: максимум и среднее среди окон, куда запросы отнесены по времени завершения. Это не профиль нагрузки по времени; точные окна приведены в windows.csv.",
      "fieldConfig": {"defaults": {"unit": "short", "noValue": "Нет данных (неизвестно)"}, "overrides": []},
