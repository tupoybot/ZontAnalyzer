        {"expr": "zont_lab_ru_per_second", "format": "table", "instant": true, "legendFormat": "Максимум {{variant}} / {{suite}} / {{years}} лет / {{scenario}} / окно {{window}} с", "refId": "A"},
        {"expr": "zont_lab_ru_per_second_mean", "format": "table", "instant": true, "legendFormat": "Среднее {{variant}} / {{suite}} / {{years}} лет / {{scenario}} / окно {{window}} с", "refId": "B"}
      ],
      "title": "RU/с — максимум и среднее последнего повтора",
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Фактически измеренные сервером RU на операцию. Пустое значение не заменяется нулём.",
