# Install as /opt/zont-analyzer/.env owned by root with mode 0600.
# Credential files are mounted read-only from /opt/zont-analyzer/secrets instead
# of being expanded by Compose or exposed through the container environment.

# Use a unique immutable tag for each manual release, for example 20260803-021500.
ZONT_ANALYZER_IMAGE_TAG=manual
ZONT_ANALYZER_FEEDBACK_PORT=8787

# Host-only test publication path; never use this setting in application code.
ZONT_ANALYZER_PUBLISH_DIR=/opt/nightscout-compose/certbot/www/tupoybot.ru/html/za
